{
  "name": "shop-suite-vendure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.json",
    "build:dashboard": "VENDURE_DASHBOARD_BUILD=true vite build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --require ts-node/register --test src/providers/*.test.ts src/plugins/*/*.test.ts",
    "start:server": "node dist/initialize.js && node dist/index.js",
    "start:worker": "node dist/index-worker.js"
  },
    "dependencies": {
        "@nestjs/common": "11.1.29",
        "@vendure/asset-server-plugin": "3.7.2",
        "@vendure/common": "3.7.2",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/graphiql-plugin": "3.7.2",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@vendure/cli": "3.7.2",
    "@types/node": "24.10.13",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "vite": "7.3.6"
  }
}
