# Postgres
POSTGRES_PASSWORD=

# Backend
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTEGRATION_SECRET=
RUST_LOG=info

# Optional Marketplace Intelligence. Store the actual LWA JSON in the existing
# secret mechanism; do not put refresh tokens or client secrets in this file.
# A connection with secret_ref "seller_de" resolves AMAZON_SECRET_SELLER_DE at runtime.
# AMAZON_SECRET_SELLER_DE=

# Amazon read-only pilot selection. Prefer .env.amazon-pilot.example together
# with compose.amazon-pilot.yml; the normal full-stack file leaves this unset.
# ESSENTIALS_MODULE_PROFILE=amazon-read-only
# AMAZON_STAGING_APPROVAL={"seller_sha256":"lowercase-sha256","region":"eu","marketplace_id":"..."}

# External AI is deliberately outside the pilot and has no active configuration.

# Optional, independent carrier connector secret references. The Admin-Center
# healthcheck verifies only that a reference was configured.
# DHL_CONNECTOR_SECRET_REF=
# DPD_CONNECTOR_SECRET_REF=

# Frontend
FRONTEND_PORT=8090

# Vendure (separate PostgreSQL database and application credentials)
VENDURE_DB_NAME=vendure
VENDURE_DB_USERNAME=vendure
VENDURE_DB_PASSWORD=
VENDURE_COOKIE_SECRET=
VENDURE_SUPERADMIN_USERNAME=
VENDURE_SUPERADMIN_PASSWORD=
VENDURE_PORT=3000
VENDURE_ASSET_URL_PREFIX=http://localhost:3000/assets/

# Storefront
STOREFRONT_PORT=3001
STOREFRONT_ORIGIN=http://localhost:3001
VENDURE_CHANNEL_TOKEN=
STOREFRONT_COOKIE_SECURE=false
