# Copy to .env.mantle-amazon on the deployment host and keep mode 0600.
# Never commit the populated file. No SP-API credential is required for uploads.
POSTGRES_PASSWORD=replace-with-a-random-secret
JWT_SECRET=replace-with-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-secret
INTEGRATION_SECRET=replace-with-a-random-secret
# Exactly 32 random bytes encoded as 64 hexadecimal characters. This key
# encrypts write-only provider credentials and must remain host-only.
PILOT_SECRETS_KEY=replace-with-64-hex-characters
MERCHANT_GIT_SHA=replace-with-the-full-live-git-sha
MANTLE_AMAZON_FRONTEND_PORT=18090
MARKETPLACE_WORKER_INTERVAL_SECONDS=5
# Mantle uses a same-origin, read-only-scoped browser session without a login
# form. The LAN/VPN-only reverse-proxy boundary remains mandatory.
MANTLE_PILOT_NO_LOGIN=true
# The button stays operator-triggered. The separately billed API key is entered
# write-only in the internal UI and is never returned to the browser.
OPENAI_STRATEGY_ENABLED=true
OPENAI_STRATEGY_MODEL=gpt-5.6
# Legacy host-only fallback; leave empty when the write-only UI is used.
OPENAI_API_KEY=
RUST_LOG=info
