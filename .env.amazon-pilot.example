# Copy to .env.amazon-pilot and provide strong local values. Never commit that file.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTEGRATION_SECRET=
# The internal pilot uses the narrow no-login shell. Generate a unique key
# before starting; CI supplies its own synthetic value.
MANTLE_PILOT_NO_LOGIN=true
PILOT_SECRETS_KEY=
PILOT_FRONTEND_PORT=8090

# Optional aggregate-only strategy panel. Leave disabled without an explicitly
# approved, separately billed OpenAI API credential.
OPENAI_STRATEGY_ENABLED=false
OPENAI_STRATEGY_MODEL=gpt-5.6
OPENAI_API_KEY=

# Keep these empty for synthetic/local testing. Live staging requires both.
# secret_ref must be "pilot_seller" for this profile.
# AMAZON_SECRET_PILOT_SELLER={"refresh_token":"...","client_id":"...","client_secret":"..."}
# AMAZON_STAGING_APPROVAL={"seller_sha256":"lowercase-sha256","region":"eu","marketplace_id":"..."}
