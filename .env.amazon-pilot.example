# Copy to .env.amazon-pilot and provide strong local values. Never commit that file.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTEGRATION_SECRET=
PILOT_FRONTEND_PORT=8090

# Keep these empty for synthetic/local testing. Live staging requires both.
